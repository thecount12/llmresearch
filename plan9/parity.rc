#!/bin/rc
# HF vs lumen parity ladder (Qwen2.5 + GGUF).  Phased checklist: PARITY_PLAN.md
# Default: print commands only. To run lumen steps on Plan 9:  run=1 rc parity.rc
# HF scripts run on a host with torch/transformers (copy the echoed python lines).
# Merge stderr into stdout for capture: use lumen -W and one >file (see main -W; >[2=1] alone is unreliable in some rc).
#
# Set these before rc:
#   gguf=Qwen2.5-0.5B-Instruct-f16.gguf
#   hf='Qwen/Qwen2.5-0.5B-Instruct'
#   tok=hello2.tok
#   row=19482
#   pos=1
#   gsteps=8   (greedy chain length for milestone 4)
#   ctx=   (optional: lumen -c N or -c 0 for full model seq; Phase 4 context / KV cap tests)
#   run=1   (optional: execute lumen; default 0 = instructions only)
#
# Build:  mk  → ./lumen or ./6.out;  mk install  → e.g. $home/bin/$objtype/lumen or /usr/william/bin/amd64/lumen (any $path/…/lumen is found below). No -m = toy; parity uses -m $gguf.
#
# Parity note:  lumen uses float32 end-to-end; HF with --dtype float16 is not bit-identical.  Layer sumsq/cksum and
# the printed top logit (e.g. 15.29 vs 15.30) may differ slightly;  greedy_id / gen[i]  should still match when the
# ladder is set up the same.  For closer layer checksums, run HF in float32 or document F16 as approximate.

if(~ $#gguf 0) gguf=Qwen2.5-0.5B-Instruct-f16.gguf
if(~ $#hf 0) hf='Qwen/Qwen2.5-0.5B-Instruct'
if(~ $#tok 0) tok=hello2.tok
if(~ $#row 0) row=19482
if(~ $#pos 0) pos=1
if(~ $#gsteps 0) gsteps=8
if(~ $#run 0) run=0

cfrag=''
if(! ~ $#ctx 0) if(! ~ $ctx '')
	cfrag=' -c '^$ctx

# lumen path:  lumenbin=...  to override; else ./lumen, ./6.out, $home/bin/$objtype/lumen, then $path/…/lumen (finds /usr/william/bin/amd64/lumen etc.)
bin=''
if(! ~ $#lumenbin 0)
	bin=$lumenbin
if(~ $#lumenbin 0) if(test -f ./lumen -a -x ./lumen) bin=./lumen
if(~ $#lumenbin 0) if(~ $#bin 0) if(test -f ./6.out -a -x ./6.out) bin=./6.out
if(~ $#lumenbin 0) if(~ $#bin 0) if(! ~ $#objtype 0) {
	lu=$home^'/bin/'^$objtype^'/lumen'
	if(test -f $lu -a -x $lu) bin=$lu
}
if(~ $#lumenbin 0) if(~ $#bin 0) if(! ~ $#cputype 0) {
	lu=$home^'/bin/'^$cputype^'/lumen'
	if(test -f $lu -a -x $lu) bin=$lu
}
if(~ $#lumenbin 0) if(~ $#bin 0) for(p in $path) {
	if(~ $#bin 0) {
		lu=$p^/lumen
		if(test -f $lu -a -x $lu) bin=$lu
	}
}
if(! ~ $#lumenbin 0) {
	if(! test -f $bin -a -x $bin) {
		echo '[parity] lumenbin is not a file or not executable: '^$lumenbin
		bin=''
	}
}

if(~ $run 1) {
	# $pid: Plan 9 process id (fallback to 0 for odd rc; keeps path non-empty for redirects).
	ps=$pid
	if(~ $#ps 0) ps=0
	tmp=/tmp/parity^$ps^'.out'
	# Grep into a second file, then test -s; direct grep|stdout can be a no-op on some rc.
	gout=/tmp/parity^$ps^'.gout'
	skip=0
	if(~ $#bin 0) {
		echo '[parity] no lumen: run  mk  or  mk install  in plan9/ (or  lumenbin=/path/to/lumen  before rc)'
		skip=1
	}
	if(! test -r $gguf) {
		echo '[parity] cannot read '^$gguf
		skip=1
	}
	if(! test -r $tok) {
		echo '[parity] cannot read '^$tok^' (try hello2.tok in cwd)'
		skip=1
	}
	if(~ $skip 0) {
		# rc: do not use  lm=-W -m …  (only -W is assigned; -m runs as a command).  Do not rely on  lm=(…)  — not all rc builds support lists.  usectx + two explicit lines work everywhere.
		usectx=0
		if(! ~ $#ctx 0) if(! ~ $ctx '')
			usectx=1
		echo '--- 1) lumen embed row '^$row^' ---'
		# -W: dup(1,2) in lumen so fprint(2) (lumen_dump, …) goes to the same file as stdout; >[2=1] is unreliable in some rc.
		if(~ $usectx 1)
			$bin -W -m $gguf -c $ctx -Z $row -n 0 >$tmp
		if(~ $usectx 0)
			$bin -W -m $gguf -Z $row -n 0 >$tmp
		if(! test -s $tmp) echo '[parity] step 1: empty capture' $status
		grep lumen_dump $tmp >$gout
		if(! test -s $gout) echo '[parity] step 1: empty file' $status
		if not
			cat $gout

		echo
		echo '--- 2) lumen -D '^$pos^' (hello2.tok) ---'
		if(~ $usectx 1)
			$bin -W -m $gguf -c $ctx -P $tok -n 0 -D $pos >$tmp
		if(~ $usectx 0)
			$bin -W -m $gguf -P $tok -n 0 -D $pos >$tmp
		if(! test -s $tmp) echo '[parity] step 2: empty capture' $status
		grep lumen_dbg $tmp >$gout
		if(! test -s $gout) echo '[parity] step 2: empty file' $status
		if not
			cat $gout

		echo
		echo '--- 3) lumen -F (next-token logits) ---'
		if(~ $usectx 1)
			$bin -W -m $gguf -c $ctx -P $tok -n 1 -F >$tmp
		if(~ $usectx 0)
			$bin -W -m $gguf -P $tok -n 1 -F >$tmp
		if(! test -s $tmp) echo '[parity] step 3: empty capture' $status
		grep lumen_hf $tmp >$gout
		if(! test -s $gout) echo '[parity] step 3: empty file' $status
		if not
			cat $gout

		echo
		echo '--- 4) greedy '^$gsteps^' steps: lumen -e vs hf_logits_ref --greedy-steps ---'
		if(~ $usectx 1)
			$bin -W -m $gguf -c $ctx -P $tok -n $gsteps -e >$tmp
		if(~ $usectx 0)
			$bin -W -m $gguf -P $tok -n $gsteps -e >$tmp
		if(! test -s $tmp) echo '[parity] step 4: empty capture' $status
		grep gen $tmp >$gout
		if(! test -s $gout) echo '[parity] step 4: empty file' $status
		if not
			cat $gout
		rm -f $tmp $gout
	}
	echo
	echo '--- Host: run these next to compare ---'
	echo ' python3 hf_hidden_ref.py -m '^$hf^' --embed-row '^$row^' --dtype float16'
	echo ' python3 hf_hidden_ref.py -m '^$hf^' -p '^$tok^' --pos '^$pos^' --dtype float16'
	echo ' python3 hf_logits_ref.py -m '^$hf^' -p '^$tok^' --dtype float16'
	echo ' python3 hf_logits_ref.py -m '^$hf^' -p '^$tok^' --dtype float16 --greedy-steps '^$gsteps
	echo ' (optional, tighter -D vs float32 lumen: repeat with --dtype float32 on the hf_hidden / hf_logits lines)'
	echo
}
if not {
echo '--- 1) embed row: lumen -Z vs hf_hidden_ref --embed-row ---'
echo ' lumen -W -m '^$gguf^$cfrag^' -Z '^$row^' -n 0 >/tmp/lumen.out; grep lumen_dump /tmp/lumen.out'
echo ' python3 hf_hidden_ref.py -m '^$hf^' --embed-row '^$row^' --dtype float16'
echo
echo '--- 2) hidden fingerprints (-D pos vs hf_hidden_ref --pos): lumen_dbg lines ---'
echo ' lumen -W -m '^$gguf^$cfrag^' -P '^$tok^' -n 0 -D '^$pos^' >/tmp/lumen.out; grep lumen_dbg /tmp/lumen.out'
echo ' python3 hf_hidden_ref.py -m '^$hf^' -p '^$tok^' --pos '^$pos^' --dtype float16'
echo ' L0: logits_h0, probs_h0 (attn bisect), preatn, attn; lumen_dbg_raw = float diff; last line pre_logits.'
echo
echo '--- 3) next-token logits: lumen -F vs hf_logits_ref (end-to-end) ---'
echo ' lumen -W -m '^$gguf^$cfrag^' -P '^$tok^' -n 1 -F >/tmp/lumen.out; grep lumen_hf /tmp/lumen.out'
echo ' python3 hf_logits_ref.py -m '^$hf^' -p '^$tok^' --dtype float16'
echo
echo '--- 4) multi-step greedy (milestone): lumen -e vs hf_logits_ref --greedy-steps ---'
echo ' gsteps=8   # optional override before rc'
echo ' lumen -W -m '^$gguf^$cfrag^' -P '^$tok^' -n '^$gsteps^' -e >/tmp/lumen.out; grep gen /tmp/lumen.out'
echo ' python3 hf_logits_ref.py -m '^$hf^' -p '^$tok^' --dtype float16 --greedy-steps '^$gsteps
echo ' Compare id= on each gen[i] line; logit may differ (GGUF vs HF F16).'
echo ' Optional: same hf_* lines with --dtype float32 for closer layer cksums to lumen (still not guaranteed identical).'
echo
echo '--- 5) Phase 4 (context): optional  ctx=128  tok=fixtures/kv64.tok  pos=63  — 64-token prefix, -D at last pos ---'
echo ' Same rc; from plan9/:  ctx=128 tok=fixtures/kv64.tok pos=63 run=1 rc parity.rc'
echo ' Expect failure if ctx < prompt_len + gsteps (lumen sysfatal).  ctx=0 uses model max seq.'
echo
echo '--- 6) moving forward ---'
echo ' Run lumen automatically:  run=1 rc parity.rc'
echo ' Host-only HF:  scripts/host_parity.sh — optional PARITY_SAVE=file; see baselines/PARITY_HELLO2_POS1.txt.'
echo ' Compare pre_logits sumsq/cksum (step 2) first; then greedy_id in lumen_hf (step 3).'
echo ' ~1% drift on L0_logits_h0 F16 GGUF vs HF FP32 is common; fix large greedy gaps, not every cksum.'
echo
echo 'Bisect: embed ok but later wrong — layer -D; L0_preatn vs HF — MHA vs wo; parity.rc step 3 — full graph.'
echo 'GGUF embed_layout from token_embd ne[].'
}
