#!/bin/rc
# Layer-0 attention bisect. Merge stderr into file: rc applies redirs left-to-right,
# so use >$tmp >[2=1] (NOT >[2=1] >$tmp — that leaves stderr on the terminal).
#
#   rc l0parity.rc
#   run=1 rc l0parity.rc
#   gguf=model.gguf tok=my.tok pos=1 run=1 rc l0parity.rc
#
# If you see no L0_ lines, check the printed 6.out status and the
# first lines of merged output (often bad -m path or missing 6.out).

if(~ $#gguf 0) gguf=Qwen2.5-0.5B-Instruct-f16.gguf
if(~ $#tok 0) tok=hello2.tok
if(~ $#pos 0) pos=1
if(~ $#run 0) run=0
if(~ $#hf 0) hf='Qwen/Qwen2.5-0.5B-Instruct'

# Docs often write /sys/src/cmd/.../file.gguf; "..." is not a real path segment.
if(~ $gguf */.../*)
	echo '[l0parity] gguf contains /.../ — replace with your real directories (ellipsis is not valid in paths).'

echo '--- Plan 9: L0_norm L0_rope L0_krope L0_attn ---'
if(~ $run 1) {
	skip=0
	if(! test -r $gguf) {
		cwd=`{pwd}
		echo '[l0parity] cannot read '^$gguf^' cwd='^$cwd
		skip=1
	}
	if(! test -r $tok) {
		cwd=`{pwd}
		echo '[l0parity] cannot read '^$tok^' cwd='^$cwd^'; repo has hello2.tok hello.tok hello_plain.tok'
		skip=1
	}
	if(~ $skip 0) {
		tmp=/tmp/l0parity.$pid.out
		6.out -m $gguf -P $tok -n 0 -D $pos >$tmp >[2=1]
		outst=$status
		# rc: $status is empty on success, else a wait msg (not numeric).
		if(! ~ $#outst 0)
			echo '[l0parity] 6.out failed:' $outst
		grep 'lumen_dbg.*L0_' $tmp
		grepst=$status
		if(! ~ $#grepst 0) {
			echo '[l0parity] no lumen_dbg L0_* lines; grep:' $grepst
			echo '[l0parity] first 16 merged lines:'
			sed '16q' $tmp
		}
		rm -f $tmp
	}
}
if not
	echo 'Dry run (no 6.out). Use: run=1 rc l0parity.rc'

echo
echo '--- Host in plan9/: python3 hf_hidden_ref.py ... | grep L0_ ---'
echo '  hf='$hf' tok='$tok
echo
echo 'L0_krope dim is kdim (e.g. 128). Match sumsq to HF after rebuild.'
